<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aarsopgoerelse.ViewModels"
             x:Class="Aarsopgoerelse.Views.IndtastningssideView"
             x:DataType="vm:IndtastningssideViewModel">

    <Grid Margin="55,90,55,55"
          RowDefinitions="*,Auto">

        <!-- Hovedindhold med tre kolonner -->
        <Grid Grid.Row="0"
              ColumnDefinitions="1.05*,1.05*,1*"
              ColumnSpacing="65">

            <!-- VENSTRE KOLONNE -->
            <StackPanel Grid.Column="0"
                        Spacing="12">

                <TextBlock Text="Lønindkomst"
                           FontWeight="Bold"
                           TextDecorations="Underline"
                           Margin="0,0,0,2"/>

                <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                    <TextBlock Text="Løn før skat og AM-bidrag:"
                               VerticalAlignment="Center"/>
                    
                    <TextBox x:Name="BruttoLoen"
                            Text="{Binding BruttoLoen}"
                            Classes.invalid="{Binding !BruttoLoenErGyldig}"
                            Grid.Column="1" Height="26" Width="110"/>
                </Grid>

                <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                    <TextBlock Text="AM-bidrag:"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="AMBidrag"
                            Text="{Binding AMBidrag}"
                            Classes.invalid="{Binding !AMBidragErGyldig}"
                             Grid.Column="1" Height="26" Width="110"/>
                </Grid>

                <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                    <TextBlock Text="A-Skat:"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="ASkat"
                            Text="{Binding ASkat}"
                            Classes.invalid="{Binding !ASkatErGyldig}"
                             Grid.Column="1" Height="26" Width="110"/>
                </Grid>

                <TextBlock Text="Pensioner, dagpenge, stipendier m.v."
                           FontWeight="Bold"
                           TextDecorations="Underline"
                           Margin="0,17,0,2"/>

                <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                    <TextBlock Text="A-kasse dagpenge:"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="AKasseDagpenge"
                            Text="{Binding AKasseDagpenge}"
                            Classes.invalid="{Binding !AKasseDagpengeErGyldig}"
                             Grid.Column="1" Height="26" Width="110"/>
                </Grid>

                <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                    <TextBlock Text="Feriedagpenge:"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="Feriedagpenge"
                            Text="{Binding Feriedagpenge}"
                            Classes.invalid="{Binding !FeriedagpengeErGyldig}"
                             Grid.Column="1" Height="26" Width="110"/>
                </Grid>

                <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                    <TextBlock Text="Sygedagpenge:"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="Sygedagpenge"
                            Text="{Binding Sygedagpenge}"
                            Classes.invalid="{Binding !SygedagpengeErGyldig}"
                             Grid.Column="1" Height="26" Width="110"/>
                </Grid>

                <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                    <TextBlock Text="Kontanthjælp:"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="Kontanthjaelp"
                            Text="{Binding Kontanthjaelp}"
                            Classes.invalid="{Binding !KontanthjaelpErGyldig}"
                             Grid.Column="1" Height="26" Width="110"/>
                </Grid>

                <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                    <TextBlock Text="Efterløn:"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="Efterloen"
                            Text="{Binding Efterloen}"
                            Classes.invalid="{Binding !EfterloenErGyldig}"
                             Grid.Column="1" Height="26" Width="110"/>
                </Grid>

                <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                    <TextBlock Text="Statens VoksenUddannelsesstøtte:"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBox x:Name="SVU"
                            Text="{Binding SVU}"
                            Classes.invalid="{Binding !SVUErGyldig}"
                             Grid.Column="1" Height="26" Width="110"/>
                </Grid>

                <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                    <TextBlock Text="Statens Uddannelsesstøtte:"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBox x:Name="SU"
                            Text="{Binding SU}"
                            Classes.invalid="{Binding !SUErGyldig}"
                             Grid.Column="1" Height="26" Width="110"/>
                </Grid>

            </StackPanel>


            <!-- MIDTERSTE KOLONNE -->
            <StackPanel Grid.Column="1"
                        Spacing="12">

                <TextBlock Text="Indbetalinger til pension"
                           FontWeight="Bold"
                           TextDecorations="Underline"
                           Margin="0,0,0,2"/>

                <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                    <TextBlock Text="Arbejdsgiveradministreret pension:"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBox x:Name="ArbejdsgiverPension"
                            Text="{Binding ArbejdsgiverPension}"
                            Classes.invalid="{Binding !ArbejdsgiverPensionErGyldig}"
                             Grid.Column="1" Height="26" Width="110"/>
                </Grid>

                <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                    <TextBlock Text="ATP via arbejdsgiver:"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="ATPAMBidragsPligt"
                            Text="{Binding ATPAMBidragsPligt}"
                            Classes.invalid="{Binding !ATPAMBidragsPligtErGyldig}"
                             Grid.Column="1" Height="26" Width="110"/>
                </Grid>

                <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                    <TextBlock Text="ATP som ikke er fra arbejdsgiver:"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBox x:Name="ATPIkkeAMBidragsPligt"
                            Text="{Binding ATPIkkeAMBidragsPligt}"
                            Classes.invalid="{Binding !ATPIkkeAMBidragsPligtErGyldig}"
                             Grid.Column="1" Height="26" Width="110"/>
                </Grid>

                <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                    <TextBlock Text="Egen indbetaling uden om arbejdsgiver:"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBox x:Name="PensionsindbetalingAfBeskattedeMidler"
                            Text="{Binding PensionsindbetalingAfBeskattedeMidler}"
                            Classes.invalid="{Binding !PensionsindbetalingAfBeskattedeMidlerErGyldig}"
                             Grid.Column="1" Height="26" Width="110"/>
                </Grid>

                <TextBlock Text="Anden personlig indkomst:"
                           FontWeight="Bold"
                           TextDecorations="Underline"
                           Margin="0,17,0,2"/>

                <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                    <TextBlock Text="Gruppelivsforsikring via fagforening:"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBox x:Name="GruppelivsForsikring"
                            Text="{Binding GruppelivsForsikring}"
                            Classes.invalid="{Binding !GruppelivsForsikringErGyldig}"
                             Grid.Column="1" Height="26" Width="110"/>
                </Grid>

                <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                    <TextBlock Text="Legater og bestemte personalegoder:"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBox x:Name="LegaterOgPersonalegoder"
                            Text="{Binding LegaterOgPersonalegoder}"
                            Classes.invalid="{Binding !LegaterOgPersonalegoderErGyldig}"
                             Grid.Column="1" Height="26" Width="110"/>
                </Grid>

                <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                    <TextBlock Text="Indskud til aldersopsparing via arbejde:"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBox x:Name="IndskudAldersopsparingViaArbejdsgiver"
                            Text="{Binding IndskudAldersopsparingViaArbejdsgiver}"
                            Classes.invalid="{Binding !IndskudAldersopsparingViaArbejdsgiverErGyldig}"
                             Grid.Column="1" Height="26" Width="110"/>
                </Grid>

                <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                    <TextBlock Text="Eventuelt andet:"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="AndetPersonligIndkomst"
                            Text="{Binding AndetPersonligIndkomst}"
                            Classes.invalid="{Binding !AndetPersonligIndkomstErGyldig}"
                             Grid.Column="1" Height="26" Width="110"/>
                </Grid>

                <TextBlock Text="Kapitalindkomst:"
                           FontWeight="Bold"
                           TextDecorations="Underline"
                           Margin="0,17,0,2"/>

                <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                    <TextBlock Text="Renteindtægter fra pengeinstitut:"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBox x:Name="Renteindtaegter"
                            Text="{Binding Renteindtaegter}"
                            Classes.invalid="{Binding !RenteindtaegterErGyldig}"
                             Grid.Column="1" Height="26" Width="110"/>
                </Grid>

            </StackPanel>


            <!-- HØJRE KOLONNE -->
            <StackPanel Grid.Column="2"
                        Spacing="12">

                <TextBlock Text="Ligningsmæssige fradrag"
                           FontWeight="Bold"
                           TextDecorations="Underline"
                           Margin="0,0,0,2"/>

                <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                    <TextBlock Text="Udgifter til fitnesscenter og musikskole:"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBox x:Name="FitnessMusikskole"
                            Text="{Binding FitnessMusikskole}"
                            Classes.invalid="{Binding !FitnessMusikskoleErGyldig}"
                             Grid.Column="1" Height="26" Width="110"/>
                </Grid>

                <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                    <TextBlock Text="Afstand fra hjem til arbejde i km:"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBox x:Name="AfstandArbejde"
                            Text="{Binding AfstandArbejde}"
                            Classes.invalid="{Binding !AfstandArbejdeErGyldig}"
                             Grid.Column="1" Height="26" Width="110"/>
                </Grid>

                <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                    <TextBlock Text="Antal dage kørt på arbejde:"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="AntalDageKoert"
                            Text="{Binding AntalDageKoert}"
                            Classes.invalid="{Binding !AntalDageKoertErGyldig}"
                             Grid.Column="1" Height="26" Width="110"/>
                </Grid>

                <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                    <TextBlock Text="Kontingent til fagforening:"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="KontingentFagforening"
                            Text="{Binding KontingentFagforening}"
                            Classes.invalid="{Binding !KontingentFagforeningErGyldig}"
                             Grid.Column="1" Height="26" Width="110"/>
                </Grid>

                <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                    <TextBlock Text="Kontingent til A-kasse:"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="KontingentAKasse"
                            Text="{Binding KontingentAKasse}"
                            Classes.invalid="{Binding !KontingentAKasseErGyldig}"
                             Grid.Column="1" Height="26" Width="110"/>
                </Grid>

                <Grid ColumnDefinitions="*,82" ColumnSpacing="8">
                    <TextBlock Text="Gaver til godkendte foreninger:"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBox x:Name="GaverTilForeninger"
                            Text="{Binding GaverTilForeninger}"
                            Classes.invalid="{Binding !GaverTilForeningerErGyldig}"
                             Grid.Column="1" Height="26" Width="110"/>
                </Grid>

                <!-- De to felter, der valideres særskilt -->
                <StackPanel Margin="0,75,0,0"
                            Spacing="12">

                        <TextBlock Text="Bopælskommune 5. sept. Sidste år:"
                                   FontWeight="Bold"
                                   TextDecorations="Underline"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <ComboBox
                            x:Name="KommuneComboBox"
                            ItemsSource="{Binding Kommunenavne}"
                            SelectedItem="{Binding KommuneComboBox}"
                            Classes.invalid="{Binding !KommuneComboBoxErGyldig}"
                            PlaceholderText="Vælg kommune"
                            Width="250"
                            HorizontalAlignment="Left"/>

                        <TextBlock Text="Er du medlem af folkekirken?"
                                   FontWeight="Bold"
                                   TextDecorations="Underline"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <ComboBox x:Name="KirkeskatComboBox"
                            Classes.invalid="{Binding !KirkeskatComboBoxErGyldig}"
                            ItemsSource="{Binding KirkeskatValgmuligheder}"
                            SelectedItem="{Binding KirkeskatComboBox}"
                            PlaceholderText="Vælg"
                            Width="250"
                            HorizontalAlignment="Left">
                        </ComboBox>

                </StackPanel>

            </StackPanel>

        </Grid>

        
        <!-- KNAP NEDERST TIL HØJRE -->
        <Button Grid.Row="1"
                x:Name="VisAarsopgoerelseButton"
                Content="{Binding VisAarsopgoerelse}"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Width="160"
                Height="60"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,20,0,0"
                Command="{Binding ToSide2Command}"/>
                
    </Grid>

</UserControl>